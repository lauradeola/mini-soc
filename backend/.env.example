PORT=3000
# Chave de quem envia logs (cabeçalho x-api-key). Para uma chave por fonte, use a tela "Fontes de logs".
API_KEY=troque-por-uma-chave-longa-e-aleatoria
# Assina os tokens de login. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Senhas dos usuários criados na primeira execução. Se ficarem vazias, o servidor gera e mostra no terminal.
ADMIN_PASSWORD=
ANALYST_PASSWORD=
# Origens permitidas quando o painel é aberto de outro endereço (ex.: Live Server)
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# true liga o simulador de tráfego e os botões de simulação do painel
SIMULATE=true
# IPs que nunca podem ser bloqueados, separados por vírgula (coloque o seu)
ALLOWLIST=
# Horário de trabalho para a regra "login fora do horário" (desligada por padrão; ligue na tela Regras)
WORK_HOURS=07-20

# Notificações (opcionais): alertas de gravidade alta e crítica
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Reputação do IP na ficha (chave gratuita em abuseipdb.com)
ABUSEIPDB_KEY=
# País do IP: arquivo GeoLite2-Country.mmdb da MaxMind (gratuito, exige conta) e o pacote opcional "maxmind"
GEOIP_DB=

# Operação
LOG_LEVEL=info
RETENTION_DAYS=90
# Pasta dos backups diários do banco (mantém as últimas 7 cópias). Vazio = sem backup.
BACKUP_DIR=
# Habilita o endpoint /metrics (formato Prometheus) com este token
METRICS_TOKEN=
